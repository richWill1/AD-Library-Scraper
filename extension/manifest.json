{
  "manifest_version": 3,
  "name": "AdSnoop: see any brand's ads",
  "short_name": "AdSnoop",
  "version": "0.2.0",
  "description": "On any brand's website, click AdSnoop to see the ads that brand is running right now.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "See this brand's ads",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
